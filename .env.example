# Every environment variable this project reads.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Django ---------------------------------------------------------------

# Optional. manage.py, config/wsgi.py and config/asgi.py each default this to
# "config.settings", and there is no second settings module, so you should not
# need to set it.
# DJANGO_SETTINGS_MODULE=config.settings

# Required. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Defaults to false. Only ever true on a laptop.
DJANGO_DEBUG=true

# Comma-separated. Defaults to empty, which Django rejects when DEBUG is false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to false. True only where something in front of Django terminates
# TLS, which on Render is the case -- it switches on the HTTPS redirect, HSTS
# and secure cookies. On a laptop there is no HTTPS to redirect to, so leaving
# this false is not a weaker setting, it is the only working one.
DJANGO_SERVED_OVER_HTTPS=false

# --- Database -------------------------------------------------------------

# Postgres, never SQLite -- see ADR-0005.
# This default matches the throwaway local credentials in docker-compose.yml.
DATABASE_URL=postgres://joostmagheteten:joostmagheteten@localhost:5432/joostmagheteten

# --- Deploy only ----------------------------------------------------------
# Set in Render, not here. `manage.py ensure_superuser` reads these during the
# deploy to give the author an account on a database that started out empty --
# Render's free instances have no shell to create one from. On a laptop you
# make your own with `manage.py createsuperuser` instead.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
